ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./cosa.db
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

AUTH_JWT_ALG=HS256
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_EXP_MINUTES=5
AUTH_REFRESH_TOKEN_KEY=change-me-to-a-different-long-random-string
AUTH_REFRESH_TOKEN_EXP=30d
AUTH_SECURE_COOKIES=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=medium
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=1.0
